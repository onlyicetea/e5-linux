- * Every command goes on whatever it answers: the second slot may be empty.
- * The last one leaves the channel on the first card, for a port without the
- * card prefix. */
+/* The cards' stacks on, from +CFUN: 0, in the vendor RIL's order: the SIMs,
+ * each card's work mode (+SPTESTMODEM, the modes +SPTESTMODE? holds), the
+ * port's card as the data card, then the stacks, the first card's first.
+ * Without the work modes the second card's stack asserts the CP
+ * (mnphone_api.c:7038).  Only slots that hold a card are sent at all: a stack
+ * brought up on an empty slot asserts the CP too (mnphone_api.c:7401, seen on
+ * the E5 on 2026-10-04), and the CP's AT server is then dead until the CP is
+ * reset -- every later command times out, ModemManager marks the modem
+ * invalid after ten of them, and the card that is in the phone is never read.
+ * Which slots hold a card is read first with +CCID? (an error: no SIM in that
+ * slot), the same query the SIM list uses.  The channel's card (AT+SPACTCARD
+ * sticks) is left on the last slot asked about, so every command below but
+ * the data-card one carries its own prefix. */
 typedef struct {
     MMBaseModemAtCommandAlloc cmds[9];
+    guint                     mode1, mode2;
+    guint                     probed;
+    gboolean                  sim[2];
 } CardsOnContext;
 
