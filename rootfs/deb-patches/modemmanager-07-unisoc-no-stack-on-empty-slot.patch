 static void
+cards_on_sequence (MMBaseModem  *self,
+                   GTask        *task)
+{
+    CardsOnContext *ctx = g_task_get_task_data (task);
+    guint           n = 0;
+
+    if (ctx->sim[0]) {
+        ctx->cmds[n].command = g_strdup ("+SPACTCARD=0;+SFUN=2");
+        ctx->cmds[n++].timeout = 60;
+    }
+    if (ctx->sim[1]) {
+        ctx->cmds[n].command = g_strdup ("+SPACTCARD=1;+SFUN=2");
+        ctx->cmds[n++].timeout = 60;
+    }
+    if (ctx->sim[1]) {
+        ctx->cmds[n].command = g_strdup_printf ("+SPACTCARD=1;+SPTESTMODEM=%u,%u",
+                                                ctx->mode1, ctx->mode2);
+        ctx->cmds[n++].timeout = 10;
+    }
+    if (ctx->sim[0]) {
+        ctx->cmds[n].command = g_strdup_printf ("+SPACTCARD=0;+SPTESTMODEM=%u,%u",
+                                                ctx->mode1, ctx->mode2);
+        ctx->cmds[n++].timeout = 10;
+    }
+    if (ctx->sim[0] || ctx->sim[1]) {
+        /* the card of the last command above is the one that carries data */
+        ctx->cmds[n].command = g_strdup ("+SPSWDATA");
+        ctx->cmds[n++].timeout = 10;
+    }
+    if (ctx->sim[0]) {
+        ctx->cmds[n].command = g_strdup ("+SPACTCARD=0;+SFUN=4");
+        ctx->cmds[n++].timeout = 60;
+    }
+    if (ctx->sim[1]) {
+        ctx->cmds[n].command = g_strdup ("+SPACTCARD=1;+SFUN=4");
+        ctx->cmds[n++].timeout = 60;
+    }
+    ctx->cmds[n].command = g_strdup ("+SPACTCARD=0;+CFUN?");
+    ctx->cmds[n++].timeout = 5;
+
+    mm_base_modem_at_sequence (self, (const MMBaseModemAtCommand *) ctx->cmds, NULL, NULL,
+                               (GAsyncReadyCallback) cards_on_sequence_ready, task);
+}
+
+static void
+cards_on_ccid_ready (MMBaseModem  *self,
+                     GAsyncResult *res,
+                     GTask        *task)
+{
+    CardsOnContext   *ctx = g_task_get_task_data (task);
+    g_autofree gchar *cmd = NULL;
+    const gchar      *response;
+
+    /* +CCID: "89861500202430712412"; an error or an empty string: no SIM in
+     * that slot.  Same test the SIM list uses, so both agree on what an empty
+     * slot is. */
+    response = mm_base_modem_at_command_finish (self, res, NULL);
+    ctx->sim[ctx->probed] = FALSE;
+    if (response) {
+        g_autofree gchar *iccid = NULL;
+
+        iccid = g_strdup (mm_strip_tag (response, "+CCID:"));
+        g_strdelimit (iccid, "\"", ' ');
+        g_strstrip (iccid);
+        ctx->sim[ctx->probed] = (*iccid != '\0');
+    }
+    ctx->probed++;
+    if (ctx->probed < G_N_ELEMENTS (ctx->sim)) {
+        cmd = g_strdup_printf ("+SPACTCARD=%u;+CCID?", ctx->probed);
+        mm_base_modem_at_command (self, cmd, 5, FALSE,
+                                  (GAsyncReadyCallback) cards_on_ccid_ready, task);
+        return;
+    }
+
+    if (!ctx->sim[0] && !ctx->sim[1])
+        mm_obj_dbg (self, "no SIM in either slot: leaving the stacks off");
+
+    cards_on_sequence (self, task);
+}
