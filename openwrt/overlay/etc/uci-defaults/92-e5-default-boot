#!/bin/sh
# E5 first boot of an image installed from Android (the flash package,
# openwrt/make-flash-bundle.sh): E5_DEFAULT_BOOT=linux in the install settings
# makes Linux the default boot, as `e5-next-boot linux` does -- otherwise the
# initramfs gives the next boot back to Android.
E5_DEFAULT_BOOT=
[ -f /etc/e5/install.conf ] && . /etc/e5/install.conf
# A card in the slot is the system the user put there, so it is the default
# system: it stays the default boot after a reboot.  Without this the phone
# went back to Android on its own (measured 2026-10-04) -- boot/init restores
# slot a unless /etc/e5linux/default-boot says linux, and nothing wrote that
# file for a card install, because the gate below only covers an install that
# asks for it in /etc/e5/install.conf.  e5-next-boot itself refuses a trial
# image (e5.openwrt= on the kernel command line), so this cannot make a test
# boot permanent.
[ -f /etc/e5/sd-root ] && E5_DEFAULT_BOOT=linux
[ "$E5_DEFAULT_BOOT" = linux ] || exit 0
# Insisted, not only created: a card update copies the old value into the new
# generation (openwrt/device-install-image.sh:345), and an "android" carried
# that way is the reboot that lands in Android.  What already says linux needs
# nothing.  e5-next-boot arms slot b as it records the choice, so the two
# cannot disagree; e5-boot-ok keeps this right on every later boot.
[ "$(cat /etc/e5linux/default-boot 2>/dev/null)" = linux ] && exit 0
/opt/e5/e5-next-boot linux
